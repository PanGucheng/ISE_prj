#=============================================================================
# finger_piano_oled.ucf  --  XC3S50AN TQ144 Stage-2 + OLED 集成引脚约束
#
# 基础引脚冻结 (全部 LVCMOS33):
#   信号              LOC    Bank  XC3S50AN 管脚名      类型
#   ----------------  -----  ----  ------------------  ------
#   clk               P57     2    IO_L09P_2/GCLK0     GCLK
#   rst_n             P3      3    IO_L02P_3           I/O
#   sensor_async[0]   P28     3    IO_L11P_3           I/O
#   sensor_async[1]   P29     3    IO_L10N_3           I/O
#   sensor_async[2]   P30     3    IO_L11N_3           I/O
#   adc_i2c_scl       P31     3    IO_L12P_3           I/O
#   adc_i2c_sda       P32     3    IO_L12N_3           I/O
#   dac_i2c_scl       P102    1    IO_L10P_1           I/O
#   dac_i2c_sda       P103    1    IO_L11P_1           I/O
#   uart_tx           P110    0    IO_L01P_0           I/O (115200 8N1 TX)
#   dbg_heartbeat     P111    0    IO_L01N_0           I/O (~1 Hz 方波心跳)
#   dbg_unused        P113    0    IO_L02N_0           I/O (固定 1'b0 接地)
#   oled_i2c_scl      P104    1    IO_L10N_1           I/O (SSD1306)
#   oled_i2c_sda      P105    1    IO_L11N_1           I/O (SSD1306)
#
#   总计 14 个用户 I/O
#=============================================================================

#-----------------------------------------------------------------------------
# SYSTEM CLOCK: P57 (全局时钟输入, 12 MHz 有源晶振)
#-----------------------------------------------------------------------------
NET "clk" LOC = P57 | IOSTANDARD = LVCMOS33;

#-----------------------------------------------------------------------------
# RESET: rst_n (低有效)
#-----------------------------------------------------------------------------
NET "rst_n" LOC = P3 | IOSTANDARD = LVCMOS33;

#-----------------------------------------------------------------------------
# 3-BIT SENSOR INPUT: LM393 比较器编码
#-----------------------------------------------------------------------------
NET "sensor_async<0>" LOC = P28 | IOSTANDARD = LVCMOS33 | PULLDOWN;
NET "sensor_async<1>" LOC = P29 | IOSTANDARD = LVCMOS33 | PULLDOWN;
NET "sensor_async<2>" LOC = P30 | IOSTANDARD = LVCMOS33 | PULLDOWN;

#-----------------------------------------------------------------------------
# ADS1115 INDEPENDENT I2C BUS (开漏, 外部 4.7 kΩ 上拉到 3.3 V)
#-----------------------------------------------------------------------------
NET "adc_i2c_scl" LOC = P31 | IOSTANDARD = LVCMOS33;
NET "adc_i2c_sda" LOC = P32 | IOSTANDARD = LVCMOS33;

#-----------------------------------------------------------------------------
# MCP4725 INDEPENDENT I2C BUS (开漏, 外部 4.7 kΩ 上拉到 3.3 V)
#-----------------------------------------------------------------------------
NET "dac_i2c_scl" LOC = P102 | IOSTANDARD = LVCMOS33;
NET "dac_i2c_sda" LOC = P103 | IOSTANDARD = LVCMOS33;

#-----------------------------------------------------------------------------
# DEBUG / UART OUTPUTS (排针 P110/P111/P113)
#-----------------------------------------------------------------------------
NET "uart_tx"       LOC = P110 | IOSTANDARD = LVCMOS33;
NET "dbg_heartbeat" LOC = P111 | IOSTANDARD = LVCMOS33;
NET "dbg_unused"    LOC = P113 | IOSTANDARD = LVCMOS33;

#-----------------------------------------------------------------------------
# SSD1306 INDEPENDENT I2C BUS (开漏, 外部 4.7 kΩ 上拉到 3.3 V)
#-----------------------------------------------------------------------------
NET "oled_i2c_scl" LOC = P104 | IOSTANDARD = LVCMOS33 | DRIVE = 12 | SLEW = SLOW;
NET "oled_i2c_sda" LOC = P105 | IOSTANDARD = LVCMOS33 | DRIVE = 12 | SLEW = SLOW;

#-----------------------------------------------------------------------------
# TIMING: 12 MHz 单一系统时钟 (83.33 ns)
#-----------------------------------------------------------------------------
NET "clk" TNM_NET = "clk_group";
TIMESPEC "TS_clk" = PERIOD "clk_group" 83.33 ns HIGH 50%;
