#=============================================================================
# periph_test.ucf  --  P9 ADS1115 ADC UART 调试版本引脚约束
#
# 物理引脚分配 (严格固定, 不改引脚, 不加内部上拉):
#
#   Signal          LOC     用途
#   --------------  ------  --------------------------------
#   clk             P57     12 MHz 有源晶振 (唯一时钟)
#   rst_n           P3      外部复位 (低有效)
#   adc_i2c_scl     P31     ADS1115 SCL (独立总线, 100 kHz 开漏)
#   adc_i2c_sda     P32     ADS1115 SDA (独立总线, 100 kHz 开漏)
#   dac_i2c_scl     P102    MCP4725 SCL (关闭 DAC, 保持 1'bz 释放)
#   dac_i2c_sda     P103    MCP4725 SDA (关闭 DAC, 保持 1'bz 释放)
#   uart_tx         P110    UART TX (115200 baud, 8N1)
#   dbg_heartbeat   P111    约 1 Hz heartbeat 方波
#   dbg_unused      P113    安全接地 (固定 1'b0)
#
# 全部 LVCMOS33, 相关 Bank VCCO = 3.3 V
# I2C 上拉依赖板级 4.7 kΩ 外部电阻, 严禁配置 PULLUP
#=============================================================================

#-----------------------------------------------------------------------------
# SYSTEM CLOCK / RESET
#-----------------------------------------------------------------------------
NET "clk"   LOC = P57 | IOSTANDARD = LVCMOS33;
NET "rst_n" LOC = P3  | IOSTANDARD = LVCMOS33;

#-----------------------------------------------------------------------------
# ADS1115 INDEPENDENT I2C BUS
#-----------------------------------------------------------------------------
NET "adc_i2c_scl" LOC = P31 | IOSTANDARD = LVCMOS33;
NET "adc_i2c_sda" LOC = P32 | IOSTANDARD = LVCMOS33;

#-----------------------------------------------------------------------------
# MCP4725 INDEPENDENT I2C BUS (RELEASED / 1'bz)
#-----------------------------------------------------------------------------
NET "dac_i2c_scl" LOC = P102 | IOSTANDARD = LVCMOS33;
NET "dac_i2c_sda" LOC = P103 | IOSTANDARD = LVCMOS33;

#-----------------------------------------------------------------------------
# DEBUG / UART OUTPUTS
#-----------------------------------------------------------------------------
NET "uart_tx"       LOC = P110 | IOSTANDARD = LVCMOS33;
NET "dbg_heartbeat" LOC = P111 | IOSTANDARD = LVCMOS33;
NET "dbg_unused"    LOC = P113 | IOSTANDARD = LVCMOS33;

#-----------------------------------------------------------------------------
# TIMING: 12 MHz 单一系统时钟
#-----------------------------------------------------------------------------
NET "clk" TNM_NET = "clk_group";
TIMESPEC "TS_clk" = PERIOD "clk_group" 83.33 ns HIGH 50%;
