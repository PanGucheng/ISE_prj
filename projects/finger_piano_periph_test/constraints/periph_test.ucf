#=============================================================================
# periph_test.ucf  --  P9 ADS1115/MCP4725 板级诊断工程引脚约束
#
# 只使用用户已确认的 Stage-2 引脚(P9 计划 §3 冻结,2026-09-16):
#
#   Signal          LOC     用途
#   --------------  ------  --------------------------------
#   clk             P57     12 MHz 有源晶振(唯一时钟)
#   rst_n           P3      外部复位(低有效)
#   adc_i2c_scl     P31     ADS1115 SCL(独立总线 1)
#   adc_i2c_sda     P32     ADS1115 SDA
#   dac_i2c_scl     P102    MCP4725 SCL(独立总线 2)
#   dac_i2c_sda     P103    MCP4725 SDA
#   dbg_alive       P110    heartbeat(本工程内重定义,正式 Stage-2
#                           的 note_debug 定义不受影响)
#   dbg_adc         P111    ADC frame activity toggle
#   dbg_error       P113    sticky error
#
# 全部 LVCMOS33,相关 Bank VCCO = 3.3 V(用户 2026-09-16 确认)。
#
# I2C 上拉是板级 4.7 kΩ 电阻:UCF 刻意**不写** PULLUP 来假装上拉
# (P9 §6/§29);控制器输出保持 0/Z 开漏语义。
# 不写 OFFSET 约束,不做任何自动 LOC。
#=============================================================================


#-----------------------------------------------------------------------------
# SYSTEM CLOCK / RESET
#-----------------------------------------------------------------------------
NET "clk"   LOC = P57 | IOSTANDARD = LVCMOS33;
NET "rst_n" LOC = P3  | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# ADS1115 INDEPENDENT I2C BUS
#-----------------------------------------------------------------------------
NET "adc_i2c_scl" LOC = P31 | IOSTANDARD = LVCMOS33;
NET "adc_i2c_sda" LOC = P32 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# MCP4725 INDEPENDENT I2C BUS
#-----------------------------------------------------------------------------
NET "dac_i2c_scl" LOC = P102 | IOSTANDARD = LVCMOS33;
NET "dac_i2c_sda" LOC = P103 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# DEBUG / STATUS OUTPUTS
#-----------------------------------------------------------------------------
NET "dbg_alive"  LOC = P110 | IOSTANDARD = LVCMOS33;
NET "dbg_adc"    LOC = P111 | IOSTANDARD = LVCMOS33;
NET "dbg_error"  LOC = P113 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# TIMING: 12 MHz 单一系统时钟
#-----------------------------------------------------------------------------
NET "clk" TNM_NET = "clk_group";
TIMESPEC "TS_clk" = PERIOD "clk_group" 83.33 ns HIGH 50%;
