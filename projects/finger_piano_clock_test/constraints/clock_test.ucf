#=============================================================================
# clock_test.ucf  --  finger_piano_clock_test (P7 板级诊断工程)
#
# 只约束 5 个已确认引脚(全部 LVCMOS33,VCCO 全 3.3 V):
#   clk        P57   12 MHz 有源晶振(唯一时钟源)
#   rst_n      P3    低有效外部复位
#   ref_2mhz   P110  ÷6    -> 2 MHz
#   ref_100khz P111  ÷120  -> 100 kHz
#   ref_1khz   P113  ÷12000 -> 1 kHz
#
# 说明:
#   - 这 5 个引脚均在 P6B 中由用户确认,不引入任何新 LOC;
#   - 三个诊断输出是普通 GPIO,绝不建时钟域、绝不写进 any always 的时钟沿;
#   - UCF 不写 OFFSET(没有板级 I/O 时序数据,不得假装已认证);
#   - 不得依赖 MAP 自动分配任何引脚。
#
# 时序:SYS_CLK_HZ = 12 MHz -> PERIOD = 1000/12 = 83.33 ns。
#=============================================================================


#-----------------------------------------------------------------------------
# SYSTEM CLOCK / RESET
#-----------------------------------------------------------------------------
NET "clk"   LOC = P57 | IOSTANDARD = LVCMOS33;
NET "rst_n" LOC = P3  | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# DIAGNOSTIC DIVIDER OUTPUTS
#-----------------------------------------------------------------------------
NET "ref_2mhz"   LOC = P110 | IOSTANDARD = LVCMOS33;
NET "ref_100khz" LOC = P111 | IOSTANDARD = LVCMOS33;
NET "ref_1khz"   LOC = P113 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# TIMING: 12 MHz 单一系统时钟(83.33 ns)
#-----------------------------------------------------------------------------
NET "clk" TNM_NET = "clk_group";
TIMESPEC "TS_clk" = PERIOD "clk_group" 83.33 ns HIGH 50%;
