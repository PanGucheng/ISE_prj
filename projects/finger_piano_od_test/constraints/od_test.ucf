#=============================================================================
# od_test.ucf -- finger_piano_od_test (P31/P32/P110 推挽方波板级诊断工程)
#
# 只约束 5 个已确认引脚(全部 LVCMOS33,VCCO 全 3.3 V):
#   clk       P57  12 MHz 有源晶振(唯一系统时钟)
#   rst_n     P3   低有效外部复位
#   p31_test  P31  推挽 1 kHz 方波
#   p32_test  P32  推挽 1 kHz 方波(与 P31 同相)
#   p110_test P110 推挽 1 kHz 方波(与 P31 同相)
#
# 说明:
#   - 五个脚都是普通 I/O,VCCO=3.3 V,LVCMOS33;
#   - **不写 PULLUP / PULLDOWN**:三个输出是推挽驱动,不需要外部/内部上拉;
#   - 输出是普通 GPIO,绝不建时钟域、绝不写进任何 always 的时钟沿;
#   - UCF 不写 OFFSET(没有板级 I/O 时序数据,不得假装已认证);
#   - 不得依赖 MAP 自动分配任何引脚。
#
# 时序:SYS_CLK_HZ = 12 MHz -> PERIOD = 1000/12 = 83.33 ns。
#=============================================================================


#-----------------------------------------------------------------------------
# SYSTEM CLOCK / RESET
#-----------------------------------------------------------------------------
NET "clk"   LOC = P57 | IOSTANDARD = LVCMOS33;
NET "rst_n" LOC = P3  | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# PUSH-PULL 1 kHz DIAGNOSTIC OUTPUTS(同相位)
#-----------------------------------------------------------------------------
NET "p31_test"  LOC = P31  | IOSTANDARD = LVCMOS33;
NET "p32_test"  LOC = P32  | IOSTANDARD = LVCMOS33;
NET "p110_test" LOC = P110 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# TIMING: 12 MHz 单一系统时钟(83.33 ns)
#-----------------------------------------------------------------------------
NET "clk" TNM_NET = "clk_group";
TIMESPEC "TS_clk" = PERIOD "clk_group" 83.33 ns HIGH 50%;
