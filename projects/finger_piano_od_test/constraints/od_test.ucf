#=============================================================================
# od_test.ucf -- finger_piano_od_test (P31/P32 open-drain IO 板级诊断工程)
#
# 只约束 3 个已确认引脚(全部 LVCMOS33):
#   clk      P57  12 MHz 有源晶振(唯一系统时钟)
#   p31_test P31  开漏输出,约 1 kHz(板级外部上拉到 3.3 V)
#   p32_test P32  开漏输出,约 2 kHz(板级外部上拉到 3.3 V)
#
# 说明:
#   - P31/P32 是 Bank 3 的普通 I/O,VCCO=3.3 V,LVCMOS33 与外部 3.3 V 上拉匹配;
#   - **不写 PULLUP**:高电平完全由板级外部电阻(4.7 kΩ 到 3.3 V)提供,
#     FPGA 内部弱上拉不参与,也不得用内部上拉替代外部电阻;
#   - 两路输出是普通 GPIO,绝不建时钟域、绝不写进任何 always 的时钟沿;
#   - UCF 不写 OFFSET(没有板级 I/O 时序数据,不得假装已认证);
#   - 不得依赖 MAP 自动分配任何引脚。
#
# 时序:SYS_CLK_HZ = 12 MHz -> PERIOD = 1000/12 = 83.33 ns。
#=============================================================================


#-----------------------------------------------------------------------------
# SYSTEM CLOCK
#-----------------------------------------------------------------------------
NET "clk" LOC = P57 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# OPEN-DRAIN DIAGNOSTIC OUTPUTS (0 / Z only;外部 3.3 V 上拉;无 PULLUP)
#-----------------------------------------------------------------------------
NET "p31_test" LOC = P31 | IOSTANDARD = LVCMOS33;
NET "p32_test" LOC = P32 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# TIMING: 12 MHz 单一系统时钟(83.33 ns)
#-----------------------------------------------------------------------------
NET "clk" TNM_NET = "clk_group";
TIMESPEC "TS_clk" = PERIOD "clk_group" 83.33 ns HIGH 50%;
