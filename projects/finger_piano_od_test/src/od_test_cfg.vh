//=============================================================================
// od_test_cfg.vh -- finger_piano_od_test 配置真值源(唯一)
//
// 本工程是独立的 P31/P32 开漏(open-drain)IO 板级诊断工程:
//   P31 输出约 1 kHz、P32 输出约 2 kHz 的开漏测试波形;
//   输出严格为 0 / Z(只拉低,绝不推挽驱动 1),由板级外部电阻上拉到 3.3 V。
//
// 所有与时钟/频率有关的字面量只允许出现在本文件。
// 12 MHz / P57 是已确认的唯一系统时钟(有源晶振)。
//=============================================================================

`define OD_SYS_CLK_HZ 12000000   // P57 有源晶振,唯一系统时钟
`define OD_P31_HZ      1000      // P31 目标方波频率
`define OD_P32_HZ      2000      // P32 目标方波频率
