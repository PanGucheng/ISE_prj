//=============================================================================
// od_test_cfg.vh -- finger_piano_od_test 配置真值源(唯一)
//
// 本工程是独立的 P31/P32/P110 板级诊断工程:
//   三个脚都由同一个计数器产生**推挽**的 1 kHz、50% 占空比方波
//   (同相位、同频率),用于示波器/频率计同时核对多个脚的驱动能力与相位。
//
// 说明:
//   - 推挽输出:高电平由 FPGA 自己驱动(不再是 open-drain / 外部上拉);
//   - P57 = 12 MHz 有源晶振,唯一时钟域;P3 = rst_n 低有效复位。
//
// 所有与时钟/频率有关的字面量只允许出现在本文件。
//=============================================================================

`define OD_SYS_CLK_HZ  12000000   // P57 有源晶振,唯一系统时钟
`define OD_TONE_HZ     1000       // 三个脚的目标方波频率
