//=============================================================================
// od_test_cfg.vh -- finger_piano_od_test 配置真值源(唯一)
//
// 本工程是独立的 P31/P32 开漏(open-drain)IO 板级诊断工程:
//   P31/P32 都是顶层 inout,严格 0 / Z,由板级外部 4.7 kΩ 电阻上拉到 3.3 V。
//   用一个运行时慢速 phase 让两路互补,每个相位保持 1 秒(12 MHz 下
//   12,000,000 个 clk),完整周期 2 秒:
//       phase = 0 : P31 = Z   , P32 = LOW
//       phase = 1 : P31 = LOW , P32 = Z
//   这样综合器不能把任何一个三态缓冲当常量优化掉,单个 bitstream 就能
//   分别验证两条开漏线的 Z(外部上拉 -> 约 3.3 V)与 LOW(约 0 V)。
//
// 所有与时钟/时间有关的字面量只允许出现在本文件。
// 12 MHz / P57 是已确认的唯一系统时钟(有源晶振)。
//=============================================================================

`define OD_SYS_CLK_HZ      12000000   // P57 有源晶振,唯一系统时钟
`define OD_PHASE_HALF_CYC  12000000   // 1 秒:每 12,000,000 个 clk 互换一次相位
