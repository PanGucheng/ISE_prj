#=============================================================================
# finger_piano.ucf  --  XC3S50AN TQ144 Stage-2 最终引脚约束
#
# Stage-2 physical pin assignment frozen 2026-09-16.
# VCCO = 3.3V confirmed by user.
# Pin legality checked against XC3S50AN-TQG144 DS557 pinout.
#
# 冻结分配(全部 LVCMOS33,全部为纯 I/O 或 GCLK,不含 JTAG/电源/GND/
# input-only/配置复用 DUAL/RHCLK 管脚):
#
#   信号              LOC    Bank  XC3S50AN 管脚名      类型
#   ----------------  -----  ----  ------------------  ------
#   clk               P57     2    IO_L09P_2/GCLK0     GCLK
#   rst_n             P3      3    IO_L02P_3           I/O
#   sensor_async[0]   P28     3    IO_L11P_3           I/O
#   sensor_async[1]   P29     3    IO_L10N_3           I/O
#   sensor_async[2]   P30     3    IO_L11N_3           I/O
#   adc_i2c_scl       P31     3    IO_L12P_3           I/O
#   adc_i2c_sda       P32     3    IO_L12N_3           I/O
#   dac_i2c_scl       P102    1    IO_L10P_1           I/O
#   dac_i2c_sda       P103    1    IO_L11P_1           I/O
#   note_debug[0]     P110    0    IO_L01P_0           I/O
#   note_debug[1]     P111    0    IO_L01N_0           I/O
#   note_debug[2]     P113    0    IO_L02N_0           I/O
#
#   总计 12 个用户 I/O(物理顶层 finger_piano_stage2_top)。
#
# 说明:
#   - 全部相关 Bank 的 VCCO 均为 3.3 V(用户 2026-09-16 确认);
#   - 两条 I2C 总线物理独立:ADS1115 走 P31/P32,MCP4725 走 P102/P103;
#   - 不使用 P76/P77(IO_L01P_1/HDC 与 IO_L02N_1/LDC0,配置期 DUAL);
#   - I2C 上拉在板级(4.7 kΩ 到 3.3 V),UCF 不写 PULLUP 代替外部上拉;
#   - I2C SCL 是同步状态机产生的开漏 GPIO,不是 FPGA 时钟:
#     **不写 TNM_NET,也不作为任何 always 的时钟沿**;
#   - 全工程仍只有 clk(P57,12 MHz)一个时钟域。
#
# Legacy(7-key 方波电子琴)finger_piano_top 的旧引脚映射已从本活动 UCF
# 删除(该 top 不再是工程顶层);历史映射保留在 projects/finger_piano/
# README.md §7 与 Git history 中。
#
# 时序:SYS_CLK_HZ = 12 000 000 -> PERIOD = 1000/12 = 83.33 ns。
#       修改 src/finger_piano_cfg.vh 的频率后必须同步修改下面的 TIMESPEC。
#=============================================================================


#-----------------------------------------------------------------------------
# SYSTEM CLOCK: P57(全局时钟输入,12 MHz 有源晶振,唯一时钟源)
#-----------------------------------------------------------------------------
NET "clk" LOC = P57 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# RESET: rst_n(低有效,外部上拉/RC)
#-----------------------------------------------------------------------------
NET "rst_n" LOC = P3 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# 3-BIT SENSOR INPUT: LM393 比较器编码
#   sensor_async[0] = CH0,权重 1; [1] = CH1,权重 2; [2] = CH2,权重 4
#   000 = 静音,001~111 = C4~B4(位序不得交换)
#-----------------------------------------------------------------------------
NET "sensor_async<0>" LOC = P28 | IOSTANDARD = LVCMOS33;
NET "sensor_async<1>" LOC = P29 | IOSTANDARD = LVCMOS33;
NET "sensor_async<2>" LOC = P30 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# ADS1115 INDEPENDENT I2C BUS(开漏,外部 4.7 kΩ 上拉到 3.3 V)
#-----------------------------------------------------------------------------
NET "adc_i2c_scl" LOC = P31 | IOSTANDARD = LVCMOS33;
NET "adc_i2c_sda" LOC = P32 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# MCP4725 INDEPENDENT I2C BUS(开漏,外部 4.7 kΩ 上拉到 3.3 V)
#   与 ADS1115 总线完全独立:无共享 SDA/SCL,无 arbiter,无 bus mux
#-----------------------------------------------------------------------------
NET "dac_i2c_scl" LOC = P102 | IOSTANDARD = LVCMOS33;
NET "dac_i2c_sda" LOC = P103 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# NOTE DEBUG: 同步/滤波/解码之后的当前音符编码(0=无音符,1~7=C4~B4)
#-----------------------------------------------------------------------------
NET "note_debug<0>" LOC = P110 | IOSTANDARD = LVCMOS33;
NET "note_debug<1>" LOC = P111 | IOSTANDARD = LVCMOS33;
NET "note_debug<2>" LOC = P113 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# TIMING: 12 MHz 单一系统时钟(83.33 ns)
#-----------------------------------------------------------------------------
NET "clk" TNM_NET = "clk_group";
TIMESPEC "TS_clk" = PERIOD "clk_group" 83.33 ns HIGH 50%;
