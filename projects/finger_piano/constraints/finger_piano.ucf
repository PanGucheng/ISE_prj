#=============================================================================
# finger_piano.ucf  --  XC3S50AN TQ144 最小系统板引脚约束
#
# 板卡信息（由用户在 2026-09-14 确认）：
#   - 系统时钟：P57 接 12 MHz 有源晶振。实测该脚为全局时钟输入：
#     ISE 自动插入 clk_BUFGP/IBUFG -> BUFGMUX，0 errors / 0 warnings。
#   - 可用 I/O 范围：P1..P40。其中 P1=TMS、P2=TDI 必须留给 JTAG，不得占用；
#     P9/P17/P26/P34=GND，P14/P23=VCCO_3，P40=VCCO_2，P22=VCCINT，
#     P36=VCCAUX，P33/P35=IPAD113/114（仅输入）。
#   - I/O 电压：3.3 V，因此 IOSTANDARD = LVCMOS33。
#
# 时序：SYS_CLK_HZ = 12 000 000 -> PERIOD = 1000/12 = 83.33 ns。
#       修改 src/finger_piano_cfg.vh 的频率后必须同步修改下面的 TIMESPEC。
#=============================================================================


#-----------------------------------------------------------------------------
# 系统时钟：P57（全局时钟输入，12 MHz 有源晶振）
#-----------------------------------------------------------------------------
NET "clk" LOC = P57 | IOSTANDARD = LVCMOS33;
NET "clk" TNM_NET = "clk_group";
TIMESPEC "TS_clk" = PERIOD "clk_group" 83.33 ns HIGH 50%;


#-----------------------------------------------------------------------------
# 复位 rst_n（低有效，外部上拉/RC）
#-----------------------------------------------------------------------------
NET "rst_n" LOC = P3 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# 7 路按键输入（压力传感器调理 + 电平判决后的 0/1 电平）
#   key_in<0> = 唱名 1 (C4) ... key_in<6> = 唱名 7 (B4)
#   极性由 src/finger_piano_cfg.vh 的 `KEY_ACTIVE_HIGH 配置，不在 UCF 里反相。
#-----------------------------------------------------------------------------
NET "key_in<0>" LOC = P4  | IOSTANDARD = LVCMOS33;
NET "key_in<1>" LOC = P5  | IOSTANDARD = LVCMOS33;
NET "key_in<2>" LOC = P6  | IOSTANDARD = LVCMOS33;
NET "key_in<3>" LOC = P7  | IOSTANDARD = LVCMOS33;
NET "key_in<4>" LOC = P8  | IOSTANDARD = LVCMOS33;
NET "key_in<5>" LOC = P10 | IOSTANDARD = LVCMOS33;
NET "key_in<6>" LOC = P11 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# 音频输出：P12 -> LM386 输入
#-----------------------------------------------------------------------------
NET "audio_out" LOC = P12 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# 调试输出：极性归一化 + 同步 + 滤波之后的按键状态（可接 LED/示波器）
#-----------------------------------------------------------------------------
NET "key_debug<0>" LOC = P13 | IOSTANDARD = LVCMOS33;
NET "key_debug<1>" LOC = P15 | IOSTANDARD = LVCMOS33;
NET "key_debug<2>" LOC = P16 | IOSTANDARD = LVCMOS33;
NET "key_debug<3>" LOC = P18 | IOSTANDARD = LVCMOS33;
NET "key_debug<4>" LOC = P19 | IOSTANDARD = LVCMOS33;
NET "key_debug<5>" LOC = P20 | IOSTANDARD = LVCMOS33;
NET "key_debug<6>" LOC = P21 | IOSTANDARD = LVCMOS33;


#-----------------------------------------------------------------------------
# 调试输出：当前音符编码（0 = 无音符，1..7 = C4..B4）
#-----------------------------------------------------------------------------
NET "note_debug<0>" LOC = P24 | IOSTANDARD = LVCMOS33;
NET "note_debug<1>" LOC = P25 | IOSTANDARD = LVCMOS33;
NET "note_debug<2>" LOC = P27 | IOSTANDARD = LVCMOS33;
